# Maintainer: Nick <hello@noobping.dev>
pkgname=pipeline-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Just-powered local pipelines and Git hooks'
arch=('x86_64' 'aarch64')
url='https://github.com/noobping/pipeline'
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
checkdepends=('just>=1.56')
optdepends=(
  'just>=1.56: execute recipes without a container-engine fallback'
  'podman: extract the official Just binary when Just is unavailable'
  'docker: extract the official Just binary when Just and Podman are unavailable'
  'git: install and execute repository hooks'
)
provides=('pipeline')
conflicts=('pipeline')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/${pkgname%-*}"

  local version rev_count rev_hash
  version="$(awk -F\" '/^version =/ { print $2; exit }' Cargo.toml)"
  rev_count="$(git rev-list --count HEAD)"
  rev_hash="$(git rev-parse --short HEAD)"
  printf '%s.r%s.g%s' "$version" "$rev_count" "$rev_hash"
}

prepare() {
  cd "$srcdir/${pkgname%-*}"
  cargo fetch --locked
}

build() {
  cd "$srcdir/${pkgname%-*}"
  cargo build --frozen --release
}

check() {
  cd "$srcdir/${pkgname%-*}"
  cargo test --frozen --release --all
}

package() {
  cd "$srcdir/${pkgname%-*}"

  install -Dm0755 target/release/pipeline "$pkgdir/usr/bin/pipeline"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
