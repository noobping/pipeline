set shell := ["bash", "-c"]

default: check

[parallel]
check: fmt clippy test scripts

fmt:
    cargo fmt --check

clippy:
    cargo clippy --locked --all-targets -- -D warnings

test:
    cargo test --locked --all

scripts:
    bash -n entrypoint.sh tests/container.sh

build: check
    cargo build --locked --release
    target/release/pipeline --version
